[Unit]
Description=CyberBadge ACP bridge (Hermes/DSH over WebSocket)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/.dsh/im/bridge
Environment=PYTHONPATH=/root/.dsh/im/bridge/.libs
ExecStart=/bin/bash -lc 'export ACP_BRIDGE_TOKEN="$(cat token.txt)"; exec /usr/bin/python3 -m uvicorn acp_bridge:app --host 100.117.57.3 --port 8100 --ws websockets --log-level warning'
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
